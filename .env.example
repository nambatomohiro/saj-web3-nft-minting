# ============================================================
# SAJ Web3 NFT ハンズオン 環境変数
#   cp .env.example .env して値を記入する
#   Part3(ローカルチェーン)だけなら空のままでもOK
# ============================================================

# セミナー専用ウォレットの秘密鍵(Part4 Amoy用)
# ★普段使いのウォレットの鍵は絶対に使わないこと(必ず新規作成したセミナー専用ウォレット)
SEMINAR_PRIVATE_KEY=

# Polygon Amoy テストネットの RPC エンドポイント(Part4用)
# 空の場合は公開RPC(https://rpc-amoy.polygon.technology)が使われる
AMOY_RPC_URL=
